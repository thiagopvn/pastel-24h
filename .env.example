# Copie este arquivo para .env e preencha os valores

# Segredo para sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_session_secret_here

# Email para certificados SSL do Caddy (Let's Encrypt)
EMAIL=your_email@example.com

# Ambiente e porta
NODE_ENV=production
PORT=5000
