# Copie este arquivo para .env e preencha os valores

# Segredo para sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_session_secret_here

# Ambiente e porta
NODE_ENV=production
PORT=5000

# Host de escuta (0.0.0.0 para aceitar conexões externas)
HOST=0.0.0.0

# Caminho do banco de dados SQLite (opcional - padrão: ./data/local.db)
# DB_PATH=/caminho/para/seu/banco.db

# Email para certificados SSL do Caddy/Let's Encrypt (se usando Caddy)
# EMAIL=your_email@example.com
